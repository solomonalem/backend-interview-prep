generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS (INTERVIEWERS) ────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  company       String?
  google_id     String?       @unique
  password_hash String?       // null if Google OAuth only
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  assessments   Assessment[]
  score_overrides Score[]     // scores this interviewer has overridden or flagged
  report_shares ReportShare[] // read-only report links they have handed out
  templates     AssessmentTemplate[]
  repo_integrations RepoIntegration[]
  grounding_documents GroundingDocument[]
  candidates    Candidate[]

  @@map("users")
}

// ─── QUESTIONS ────────────────────────────────────────────────────────────────

model Question {
  id          String          @id @default(cuid())
  text        String          // the question shown to candidate

  topic       String          // e.g. "MongoDB", "Node.js", "Security"
  difficulty  Difficulty
  type        QuestionType
  domain      String?         // e.g. "healthcare", "fintech" — null = general

  // Rubric: used by Claude to score answers (never shown to candidates)
  core_answer_guide       String
  senior_signal_guide     String
  trap_guide              String
  evidence_guide          String

  // Display: shown in study mode after answer revealed (job seeker mode)
  core_answer_display     String
  senior_signal_display   String
  trap_display            String

  // ── Provenance (design §4) ─────────────────────────────────────────────────
  // Where this question came from. Trustworthy from Slice 3 onwards; rows that
  // predate it all read `manual`, since nothing recorded the difference at the
  // time and guessing retroactively would be worse than a known gap.
  source        QuestionSource @default(manual)
  // The finding that motivated it, giving question → finding → file:lines.
  // SetNull rather than Cascade: a vetted question outlives the scan that
  // inspired it, and losing the citation must not delete the question.
  repo_finding_id String?
  repo_finding    RepoFinding? @relation(fields: [repo_finding_id], references: [id], onDelete: SetNull)

  // The document that motivated it. Same SetNull reasoning as the finding
  // above: deleting the source document costs the citation, never the question.
  grounding_document_id String?
  grounding_document    GroundingDocument? @relation(fields: [grounding_document_id], references: [id], onDelete: SetNull)

  // Free-form labels the manager applies. An array rather than a table
  // because a tag has no properties, no lifecycle and no meaning beyond the
  // string — the moment it needs an owner or a colour it should become one.
  tags          String[]      @default([])

  // Metadata
  is_active     Boolean       @default(true)
  // vetted = human-approved and safe to use as-is. draft = AI-generated and
  // not yet reviewed; must never be treated as vetted anywhere.
  status        QuestionStatus @default(vetted)
  created_by    String?       // null = system question; cuid = user-created
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  assessment_questions  AssessmentQuestion[]
  answers               Answer[]
  answer_drafts         AnswerDraft[]

  @@index([topic])
  @@index([difficulty])
  @@index([domain])
  @@index([status])
  @@map("questions")
}

enum QuestionStatus {
  vetted
  draft
}

enum QuestionSource {
  manual       // written by a human
  generated    // AI-written from a topic
  repo_grounded // AI-written from a finding about the manager's own codebase
  // AI-written from a document the manager supplied (architecture note, project
  // description, detailed JD). The middle grounding tier: weaker than a repo
  // scan, which reads the code itself, but far better grounded than a topic.
  document_grounded
}

enum Difficulty {
  junior
  mid
  senior
  staff
}

enum QuestionType {
  conceptual
  scenario
  rca
  design
  behavioral
}

// ─── ASSESSMENTS ─────────────────────────────────────────────────────────────

// A saved starting point for an assessment.
//
// A template is a RECIPE, never a result: picking one opens the builder
// pre-filled and fully editable, and nothing exists until the manager presses
// create. That is the whole design constraint — a one-click "send the standard
// backend screen" that still passes through the same review of what is
// actually being asked.
//
// owner_id NULL means a built-in: seeded from the vetted bank, visible to
// everyone, editable by nobody. A manager's own templates sit beside them.
model AssessmentTemplate {
  id          String   @id @default(cuid())
  owner_id    String?
  owner       User?    @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Ordered, and deliberately a plain array rather than a join table: a
  // template is a list of ids that may rot, not a set of live relations. A
  // question that is later archived must not delete itself out of the
  // template or block its use — the builder warns and drops it instead.
  question_ids String[]

  timer_minutes      Int?
  proctoring_config  Json?
  probes_mode        ProbesMode @default(flagged_only)
  probe_time_seconds Int        @default(90)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([owner_id])
  @@map("assessment_templates")
}

model Assessment {
  id          String    @id @default(cuid())
  title       String
  owner_id    String
  owner       User      @relation(fields: [owner_id], references: [id])

  // Timer config
  timer_enabled     Boolean   @default(false)
  timer_seconds     Int?      // null if no timer

  // Proctoring config (stored as JSON)
  proctoring_config Json      @default("{\"track_tab_switches\":true,\"track_focus_loss\":true,\"detect_paste\":true,\"detect_idle\":true,\"tab_switch_flag_threshold\":3}")

  // Features
  confidence_rating_enabled Boolean @default(true)

  // Follow-up probes. The column default is `off` so every assessment that
  // existed before this feature behaves exactly as it did; the API defaults a
  // NEW assessment to `flagged_only` instead. The two defaults are deliberately
  // different — one is about not changing the past, the other about what a
  // manager should get when they don't express a preference.
  // Days of silence before the system nudges a candidate who never started.
  // NULL is off, and off is the default: an assessment that emails people on
  // its own is a decision a manager makes, not one they inherit.
  auto_reminder_days Int?

  probes_mode        ProbesMode @default(off)
  // Seconds a candidate gets to defend one answer. 60-180, validated at the
  // API; a defense is meant to be a reflex, not a second essay.
  probe_time_seconds Int        @default(90)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  questions   AssessmentQuestion[]
  links       AssessmentLink[]
  sessions    Session[]

  @@map("assessments")
}

enum ProbesMode {
  off          // no probes; byte-for-byte the pre-feature behavior
  flagged_only // only where verification matters most (see probe.service)
  all          // every answered question gets one
}

// Join table: Assessment ↔ Question (with ordering)
// One question's place in one assessment — AND a copy of it as it was.
//
// THE SNAPSHOT. Before this, an assessment referenced a question by id and
// everything read it live, which was harmless only while questions never
// changed. This wave adds editing and archiving of vetted questions, so the
// live reference becomes a way to rewrite history: edit a rubric and last
// month's report now claims the candidate was scored against words that did
// not exist when they answered.
//
// So the text and the four scoring guides are copied at assessment creation,
// and the candidate flow, the scorer and the report all read the copy. The
// tradeoff is real and accepted: an assessment does NOT pick up later
// improvements to a question, and a typo fixed in the bank stays wrong in
// assessments already built from it. That is the correct direction to be
// wrong in — what was asked is a fact about the past, not a view of the
// present.
//
// Nullable, with every reader falling back to the live question, so rows that
// predate the snapshot keep working exactly as they did.
model AssessmentQuestion {
  id            String      @id @default(cuid())
  assessment_id String
  question_id   String
  position      Int         // display order (0-indexed)

  snapshot_text                String?
  snapshot_core_answer_guide   String?
  snapshot_senior_signal_guide String?
  snapshot_trap_guide          String?
  snapshot_evidence_guide      String?

  assessment    Assessment  @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [question_id], references: [id])

  @@unique([assessment_id, position])
  @@unique([assessment_id, question_id])
  @@map("assessment_questions")
}

// ─── ASSESSMENT LINKS (SHAREABLE URLS) ───────────────────────────────────────

// A person the manager is assessing — THEIR record, not an account.
//
// The candidate never sees this, never logs in, and has no password: they click
// a signed link and that is the whole of their relationship with the product.
// This row exists so the manager can answer "what have we sent Alex, and how
// did it go" without reading down a list of assessments.
//
// Identity is (owner, email), because email is the only stable handle a person
// without an account has. Scoped to the owner so two managers assessing the
// same person keep separate notes — org-level sharing is blueprint C.
model Candidate {
  id         String   @id @default(cuid())
  owner_id   String
  owner      User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  name       String
  email      String   // always stored lowercase — see normaliseEmail
  notes      String?  // the manager's own notes; never shown to the candidate

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  links      AssessmentLink[]

  @@unique([owner_id, email])
  @@index([owner_id])
  @@map("candidates")
}

model AssessmentLink {
  id              String      @id @default(cuid())
  token           String      @unique   // random 10-char, URL-safe — this is the URL slug
  assessment_id   String
  assessment      Assessment  @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  candidate_label String?     // e.g. "Candidate A" — optional, auto-defaults to "Candidate N"
  // Optional. When set, the link is emailed to the candidate and this becomes
  // the identity we can de-duplicate on — a candidate has no account, so it is
  // the only reliable way to tell "already took this" from "new person".
  candidate_email String?
  // The record this link belongs to, when there is one. Nullable and SetNull
  // on delete: deleting a candidate record must never take an assessment, a
  // session or a report with it — the link simply goes back to standing alone,
  // exactly as every link did before records existed.
  candidate_id    String?
  candidate       Candidate?  @relation(fields: [candidate_id], references: [id], onDelete: SetNull)

  // NULL means no expiry. Nullable as of this wave: the column has always
  // existed and always been enforced, but a manager had no way to say "this
  // one should stay open", and 7 days of silence is not consent to a closed
  // door. An expiry only gates STARTING — a session already in progress is
  // governed by its own timer and is never cut off by this.
  expires_at      DateTime?

  // Manual nudges. Both are stamps rather than counters: what matters is
  // whether we have already written to this person, and when.
  reminder_sent_at      DateTime?
  // The automatic sweep writes here and checks it first, which is the whole of
  // the no-spam rule: at most one automatic reminder per link, ever.
  auto_reminder_sent_at DateTime?
  opened_at       DateTime?   // set when candidate first clicks link
  session_id      String?     @unique  // set when session is created from this link

  created_at  DateTime  @default(now())

  session     Session?  @relation(fields: [session_id], references: [id])

  @@index([assessment_id, candidate_email])
  @@index([candidate_id])
  @@map("assessment_links")
}

// ─── SESSIONS (A CANDIDATE TAKING AN ASSESSMENT) ─────────────────────────────

model Session {
  id              String          @id @default(cuid())
  assessment_id   String
  assessment      Assessment      @relation(fields: [assessment_id], references: [id])

  candidate_label String?         // carried from AssessmentLink

  // A manager walking their own assessment to see what they are sending.
  //
  // Preview sessions are real sessions — the same questions, timer, proctoring
  // and follow-ups, because a preview that behaves differently is not a
  // preview. What they never become is DATA: no scoring, no report, no
  // candidate record, nothing in a dashboard. They are deleted after a day.
  is_preview      Boolean         @default(false)

  status          SessionStatus   @default(not_started)
  started_at      DateTime?
  submitted_at    DateTime?       // null until submitted
  auto_submitted  Boolean         @default(false)  // true if timer expired

  // Session JWT for candidate API calls during assessment
  session_token   String?         @unique

  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  link            AssessmentLink?
  shares          ReportShare[]
  answers         Answer[]
  drafts          AnswerDraft[]
  behavior_events BehaviorEvent[]
  report          Report?

  @@index([assessment_id])
  @@map("sessions")
}

enum SessionStatus {
  not_started
  in_progress
  submitted
  expired
}

// ─── ANSWERS ─────────────────────────────────────────────────────────────────

model Answer {
  id              String    @id @default(cuid())
  session_id      String
  session         Session   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question_id     String
  question        Question  @relation(fields: [question_id], references: [id])
  position        Int       // which question in the assessment (0-indexed)

  text            String    // the candidate's answer text

  // ── An optional code sketch supporting the answer ────────────────────────
  // Read, never run: there is no execution environment anywhere in this
  // product (see packages/types/src/snippet.ts for why that is a decision
  // rather than a gap). The sketch is evidence inside the answer, not a
  // submission of its own — it is scored with the prose, quoted by follow-up
  // probes, and shown under the answer in the report.
  //
  // Both columns move together: null/null when nothing was attached. A
  // language with no code would be a setting nobody chose.
  snippet_code     String?  // verbatim, capped at SNIPPET_MAX_CHARS
  snippet_language String?  // one of SNIPPET_LANGUAGES; 'auto' pins nothing

  confidence_rating Int?    // 1–5, null if feature disabled or skipped
  time_spent_ms   Int       // milliseconds from question shown to answer submitted

  paste_detected  Boolean   @default(false)
  paste_char_count Int?     // largest paste char count during this question

  source          AnswerSource  @default(submitted)

  scoring_status  ScoringStatus @default(pending)
  submitted_at    DateTime  @default(now())

  score           Score?
  probe           Probe?

  @@unique([session_id, question_id])
  @@index([session_id])
  @@map("answers")
}

// How an answer came to exist.
//
// `submitted` is a candidate pressing the button. `draft_at_expiry` is their
// last autosaved draft, promoted when the clock ran out before they submitted
// — the same words they typed, arriving the only way they still could. The
// report says which, because a reader is entitled to know whether the
// candidate chose to hand that in.
enum AnswerSource {
  submitted
  draft_at_expiry
}

// Work in progress on one question.
//
// A SEPARATE TABLE, not columns on Answer, and the reason is blast radius. An
// Answer row is load-bearing: its existence is how the session counts progress,
// how scoring finds work, and what the report walks. A draft that lived there
// would have to be filtered out of every one of those paths, and the first
// place we missed would put a phantom answer in a hiring report. Here, a draft
// is structurally incapable of being mistaken for an answer — nothing that
// reads answers can see this table.
//
// One row per question per session, overwritten in place: only the latest
// draft is worth anything.
model AnswerDraft {
  id          String   @id @default(cuid())
  session_id  String
  session     Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question_id String
  question    Question @relation(fields: [question_id], references: [id])
  position    Int

  text             String  @default("")
  snippet_code     String?
  snippet_language String?

  saved_at    DateTime @updatedAt
  created_at  DateTime @default(now())

  @@unique([session_id, question_id])
  @@index([session_id])
  @@map("answer_drafts")
}

enum ScoringStatus {
  pending
  scoring
  scored
  failed
}

// ─── SCORES ──────────────────────────────────────────────────────────────────

model Score {
  id          String  @id @default(cuid())
  answer_id   String  @unique
  answer      Answer  @relation(fields: [answer_id], references: [id], onDelete: Cascade)

  // Component scores (0–100)
  core_pct            Int
  senior_signal_pct   Int
  trap_pct            Int
  evidence_pct        Int

  // Claude's one-sentence reasoning per component
  core_reasoning          String
  senior_signal_reasoning String
  trap_reasoning          String
  evidence_reasoning      String

  // Weighted total
  total_pct   Int     // calculated: core*0.25 + senior*0.35 + trap*0.25 + evidence*0.15

  // Claude's structured feedback
  what_was_hit      String[]  // array of strings: things candidate got right
  what_was_missed   String[]  // array of strings: things candidate missed
  recommended_probe String    // suggested live follow-up question

  // Confidence delta
  confidence_flag   ConfidenceFlag?  // null if confidence rating disabled

  // Metadata
  model_used  String    // e.g. "claude-sonnet-4-6"
  scored_at   DateTime  @default(now())

  // ── Human override ─────────────────────────────────────────────────────────
  // The interviewer has the final say, but the AI's own numbers are evidence of
  // how the rubric was applied — so an override is stored ALONGSIDE, never over
  // the top. Every column above this line is written once, by the scorer, and
  // is never modified by an override.
  //
  // All nullable: a score with no override is the normal case. `adjusted`
  // carries at least one number; `disagree` may carry none, which is how an
  // interviewer registers "this is wrong" without inventing a figure.
  override_flag           OverrideFlag?
  override_note           String?       // required whenever a flag is set
  overridden_total_pct    Int?
  // Per-component overrides. Any left null falls back to the AI's value, so a
  // manager can correct senior signal alone without restating the other three.
  overridden_core_pct           Int?
  overridden_senior_signal_pct  Int?
  overridden_trap_pct           Int?
  overridden_evidence_pct       Int?
  overridden_by           String?
  overridden_by_user      User?         @relation(fields: [overridden_by], references: [id])
  overridden_at           DateTime?

  @@map("scores")
}

enum OverrideFlag {
  adjusted // the interviewer supplied corrected numbers
  disagree // the interviewer disagrees; numbers optional
}

enum ConfidenceFlag {
  well_calibrated
  overconfident
  underconfident
}

// ─── FOLLOW-UP PROBES ────────────────────────────────────────────────────────
// One optional follow-up per answer, generated from what the candidate actually
// wrote and answered under a short timer. The signal is not the defense score
// on its own — it is the DELTA between the answer and the defense, which is why
// this hangs off Answer rather than standing alone.

model Probe {
  id          String  @id @default(cuid())
  answer_id   String  @unique
  answer      Answer  @relation(fields: [answer_id], references: [id], onDelete: Cascade)

  // Null only on a generation_failed row: there is no probe text because the
  // call never produced one. Storing the row anyway is deliberate — the report
  // has to be able to say a follow-up was due and didn't happen, rather than
  // silently looking like a question that was never probed.
  text        String?
  status      ProbeStatus @default(generated)

  candidate_answer String?
  time_spent_ms    Int?

  // ── Defense scoring: a REDUCED rubric ──────────────────────────────────────
  // Core and senior signal only. Trap and evidence do not apply to a 90-second
  // defense of something you already wrote — asking for a worked example under
  // that clock would measure typing speed.
  defense_core_pct           Int?
  defense_senior_signal_pct  Int?
  defense_core_reasoning     String?
  defense_senior_reasoning   String?
  // core and senior re-weighted against each other (25/35 → 41.7/58.3), so
  // senior signal stays the dominant term exactly as it is in a full score.
  defense_pct                Int?
  model_used                 String?
  scored_at                  DateTime?

  created_at  DateTime @default(now())

  @@map("probes")
}

enum ProbeStatus {
  generated         // shown to the candidate, not yet answered
  answered          // they wrote something
  unanswered        // the timer ran out on an empty box — a legitimate outcome
  generation_failed // we could not produce one; never counted against anyone
}

// ─── BEHAVIOR EVENTS ─────────────────────────────────────────────────────────

model BehaviorEvent {
  id          String            @id @default(cuid())
  session_id  String
  session     Session           @relation(fields: [session_id], references: [id], onDelete: Cascade)

  type        BehaviorEventType
  timestamp   BigInt            // unix ms
  question_index Int            // which question was active (0-indexed)

  // Optional metadata
  char_count      Int?          // paste events: character count of pasted text
  idle_duration_ms Int?         // idle events: how long idle in ms

  @@index([session_id])
  @@map("behavior_events")
}

enum BehaviorEventType {
  tab_switch
  focus_loss
  paste
  idle
  // A write the server accepted inside the expiry grace window. Recorded for
  // honesty rather than suspicion: it is expected mechanics (an autosave in
  // flight when the clock ran out), and the report presents it as context, not
  // as a flag.
  late_write
}

// ─── REPORTS ─────────────────────────────────────────────────────────────────

// A read-only link to one session's report.
//
// The same shape as a candidate link and for the same reason: the person
// reading it — a teammate, a hiring panel, the candidate's future manager —
// has no account here and should not need one. The token authorises exactly
// one report view and nothing else; it is resolved by its own code path, not
// by relaxing the check that protects everything else.
//
// Several per report is deliberate: sending one link to two people and then
// wanting to cut off one of them is the normal case, and it is only possible
// if they were different links to begin with. Revocation is per link.
model ReportShare {
  id         String    @id @default(cuid())
  session_id String
  session    Session   @relation(fields: [session_id], references: [id], onDelete: Cascade)

  token      String    @unique // random, URL-safe — the whole of the authorisation
  created_by String
  creator    User      @relation(fields: [created_by], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  // Set, never deleted: a revoked link stays on the list so the manager can see
  // that it existed and is now dead, rather than wondering where it went.
  revoked_at DateTime?

  @@index([session_id])
  @@map("report_shares")
}

model Report {
  id          String    @id @default(cuid())
  session_id  String    @unique
  session     Session   @relation(fields: [session_id], references: [id])

  overall_pct Int
  verdict     Verdict

  // Proctoring summary (computed)
  tab_switch_count  Int
  focus_loss_count  Int
  paste_count       Int
  idle_count        Int
  proctoring_context String  // Claude-generated context note

  // PDF
  pdf_url     String?   // R2 URL, null until generated
  pdf_status  PdfStatus @default(pending)

  // Email
  email_sent_at DateTime?

  generated_at DateTime @default(now())

  @@map("reports")
}

enum Verdict {
  Strong_Senior
  Approaching_Senior
  Mid_Level
  Junior
}

enum PdfStatus {
  pending
  generating
  ready
  failed
}

// ─── STUDY PROGRESS (JOB SEEKER MODE) ────────────────────────────────────────

model StudyProgress {
  id          String    @id @default(cuid())
  user_id     String
  question_id String

  rating      StudyRating           // last self-rating
  next_review DateTime              // spaced repetition: when to show again
  review_count Int       @default(0)
  last_seen   DateTime  @default(now())

  @@unique([user_id, question_id])
  @@index([user_id, next_review])
  @@map("study_progress")
}

enum StudyRating {
  missed
  partial
  got_it
}

// ─── STORIES (JOB SEEKER MODE) ───────────────────────────────────────────────

model Story {
  id          String    @id @default(cuid())
  user_id     String
  title       String
  type        StoryType
  situation   String
  task        String
  action      String
  result      String
  tags        String[]  // topic tags, e.g. ["MongoDB", "RCA", "Performance"]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([user_id])
  @@map("stories")
}

enum StoryType {
  bug_fix
  feature
  incident
  architecture
}

// ─── REPO GROUNDING (docs/DESIGN_REPO_GROUNDING.md) ──────────────────────────
// A manager connects a GitHub repository so questions can be grounded in the
// system a candidate would actually work on.
//
// CARDINAL RULE (design §2.2): source code is NEVER stored. These tables hold
// the connection and which repos it covers. Derived findings and citations
// arrive in Slice 2; file contents never do, anywhere.

model RepoIntegration {
  id              String   @id @default(cuid())
  owner_id        String
  owner           User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  // 'github' today. The column exists so GitLab/Bitbucket can reuse these
  // tables later — everything after the clone step is provider-agnostic.
  provider        String   @default("github")

  // The GitHub App installation. Not a credential: tokens are minted from it
  // on demand via the app's private key and expire in an hour, so there is
  // nothing long-lived here to leak.
  installation_id String
  account_login   String   // the org/user the app is installed on

  // revoked = the manager disconnected, here or on GitHub. The row and its
  // repos are kept (derived data survives, per §2.1); only re-scanning stops.
  status          IntegrationStatus @default(active)

  // Analysis sees only structural summaries, never raw code bodies (§2.5).
  // Lives here from day one, as the design requires; Slice 2 consumes it.
  strict_mode     Boolean  @default(false)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  repos           RepoRef[]

  // One integration per provider per owner. Reconnecting after a disconnect
  // updates this row rather than orphaning the repos hanging off it.
  @@unique([owner_id, provider])
  @@map("repo_integrations")
}

enum IntegrationStatus {
  active
  revoked
}

model RepoRef {
  id              String          @id @default(cuid())
  integration_id  String
  integration     RepoIntegration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  full_name       String          // "org/repo"
  default_branch  String

  // The most recent scan, for showing state without loading the whole history.
  // Intentionally not a relation: RepoScan already points here, and a second
  // FK in the other direction would make the two able to disagree.
  last_scan_id    String?

  created_at      DateTime        @default(now())

  scans           RepoScan[]

  @@unique([integration_id, full_name])
  @@index([integration_id])
  @@map("repo_refs")
}

// ─── REPO SCANS (design §5) ──────────────────────────────────────────────────
// One run of the pipeline: snapshot → detect stack → select files → analyse →
// persist findings → wipe. The snapshot lives in a temp directory for the
// duration of the job and is deleted in a finally block; NOTHING about it is
// stored here beyond counts.

model RepoScan {
  id           String     @id @default(cuid())
  repo_ref_id  String
  repo_ref     RepoRef    @relation(fields: [repo_ref_id], references: [id], onDelete: Cascade)

  status       ScanStatus @default(queued)
  started_at   DateTime?
  finished_at  DateTime?

  // Readable failure text. Must never carry file contents (§2.2) — the pipeline
  // constructs these messages itself rather than passing raw errors through.
  error        String?

  // { files_seen, files_selected, files_analyzed, tokens_used, stack: [...] }.
  // Counts and labels only.
  stats        Json?

  // True when analysis failed partway: the findings from completed batches are
  // kept rather than thrown away, but the scan is not a full picture.
  partial      Boolean    @default(false)

  created_at   DateTime   @default(now())

  findings     RepoFinding[]

  @@index([repo_ref_id])
  @@map("repo_scans")
}

enum ScanStatus {
  queued
  cloning
  analyzing
  done
  failed
}

// A derived observation about the repository. `detail` is prose written by the
// analyser ABOUT the code — never the code itself. `excerpt` is the single
// exception and is capped hard (§2.2): at most 3 lines, and empty in strict mode.
/// A document the manager supplied to ground questions in — an architecture
/// note, a project description, a detailed JD. Middle grounding tier: no repo
/// access required.
///
/// Unlike repository source, storing this is correct rather than merely
/// tolerable: the manager typed or uploaded it themselves, knowing it would be
/// used to write questions. It is kept so a question's provenance stays
/// answerable and so regeneration does not require re-uploading.
///
/// INTERVIEWER-ONLY, exactly like a finding. Nothing here reaches a candidate.
model GroundingDocument {
  id         String   @id @default(cuid())
  owner_id   String
  owner      User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  title      String   // filename, or a title the manager typed
  text       String   // the pasted or extracted text, as given

  /// The elicitation round, when there was one: the gaps we asked about and
  /// what the manager answered. Json rather than a table because it is read
  /// as a unit, never queried across, and its shape is one round of Q&A.
  /// Null means the document was sufficient on its own.
  elicitation_qa Json?

  questions  Question[]

  created_at DateTime @default(now())

  @@index([owner_id])
  @@map("grounding_documents")
}

model RepoFinding {
  id           String      @id @default(cuid())
  scan_id      String
  scan         RepoScan    @relation(fields: [scan_id], references: [id], onDelete: Cascade)

  kind         FindingKind
  title        String      // e.g. "Outbox pattern in order-service"
  detail       String      // 1–3 sentences, derived — never raw code

  // Citation, so a manager can judge whether a grounded question is fair.
  file_path    String?
  line_start   Int?
  line_end     Int?
  excerpt      String?     // ≤3 lines; null in strict mode

  // Question ids generated from this finding — a denormalised counter so the
  // findings list can show "2 questions" without joining.
  used_in_questions String[] @default([])

  questions    Question[]

  created_at   DateTime    @default(now())

  @@index([scan_id])
  @@index([kind])
  @@map("repo_findings")
}

enum FindingKind {
  stack
  pattern
  risk
  architecture
  domain
}
